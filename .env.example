# ============================================================
# Swerrv Docker Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_NAME=swerrv
DB_USERNAME=root
DB_PASSWORD= REDACTED_DATABASE_PASSWORD

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here

# ── Stripe ──────────────────────────────────────────────────
STRIPE_API_KEY=REDACTED_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET= REDACTED_STRIPE_WEBHOOK_SECRET

# ── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── CORS (comma-separated origins) ─────────────────────────
APP_CORS_ORIGINS=http://localhost,http://localhost:80
